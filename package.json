{
  "name": "@myriadcodelabs/docs-navigation-mcp",
  "version": "0.2.1",
  "description": "A local-first MCP server for navigating and maintaining arbitrary hierarchical documentation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "docs-navigation-mcp": "dist/main.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "release:check": "npm run typecheck && npm test && npm run build && npm pack --dry-run"
  },
  "keywords": [
    "mcp",
    "documentation",
    "model-context-protocol",
    "developer-tools"
  ],
  "author": "Muhammad Ismail Khan",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhammadismailkhan0009/docs-navigation-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/muhammadismailkhan0009/docs-navigation-mcp/issues"
  },
  "homepage": "https://github.com/muhammadismailkhan0009/docs-navigation-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
